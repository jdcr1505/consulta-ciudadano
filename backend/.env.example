# Copie este archivo a .env y ajuste los valores. NUNCA suba .env al repositorio.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://consulta:consulta_dev@localhost:5432/consulta_ciudadano"

# Secretos: genere valores propios, p. ej.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambie-este-secreto-de-desarrollo-con-al-menos-32-caracteres
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=12

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Contraseña temporal (HU02) y bloqueo de cuenta (HU03)
TEMP_PASSWORD_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15

# Correo: "dev" guarda los correos en ./dev-outbox (SIMULADO, no envía nada); "smtp" envía de verdad
MAIL_MODE=dev
MAIL_FROM="Registraduría Konrad Lorenz <no-reply@example.test>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Primer administrador (lo crea `npm run db:seed`; debe cambiar la contraseña en el primer acceso)
ADMIN_IDENTIFICACION=1000000001
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=Del Sistema
ADMIN_CORREO=admin@example.test
ADMIN_INITIAL_PASSWORD=Admin1

    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "edu.konradlorenz.consultaciudadano",
      "backgroundColor": "#09090b",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 4
    },
    "extra": {
      "apiUrl": "http://10.0.2.2:4000",
      "eas": {
        "projectId": "0edfb234-d1b8-4d3c-ad8a-a8b30dad0a1a"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa solo para leer el código de barras de la cédula. La imagen no se guarda ni se envía."
        }
      ]
